@* Ethan Wood - Section 2 *@
@* Collection.cshtml - Displays all movies in the collection in a Bootstrap-styled table *@

@model List<Movie>

@{
    ViewData["Title"] = "Collection";
}

@* Page header with title and Add Movie button *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Movie Collection</h1>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Add">Add Movie</a>
</div>

@* Bootstrap table: striped, bordered, hover; responsive wrapper for small screens *@
<div class="table-responsive rounded border shadow-sm">
    <table class="table table-hover table-striped table-bordered mb-0">
        <thead class="table-dark">
            <tr>
                <th>Category</th>
                <th>Title</th>
                <th>Year</th>
                <th>Director</th>
                <th>Rating</th>
                <th>Edited</th>
                <th>Lent To</th>
                <th>Copied to Plex</th>
                <th>Notes</th>
                <th class="text-center" style="width: 140px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@(x.Category?.CategoryName ?? "—")</td>
                    <td>@x.Title</td>
                    <td>@x.Year</td>
                    <td>@(x.Director ?? "—")</td>
                    <td>@(x.Rating ?? "—")</td>
                    <td>
                        @if (x.Edited)
                        {
                            <span class="badge bg-secondary">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark">No</span>
                        }
                    </td>
                    <td>@(x.LentTo ?? "—")</td>
                    <td>
                        @if (x.CopiedToPlex)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark">No</span>
                        }
                    </td>
                    <td>@(x.Notes ?? "—")</td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Edit" asp-route-id="@x.MovieId">Edit</a>
                            <a class="btn btn-outline-danger" asp-controller="Home" asp-action="Delete" asp-route-id="@x.MovieId">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* Empty state message when there are no movies in the collection *@
@if (Model.Count == 0)
{
    <p class="text-muted text-center mt-3">No movies in the collection yet. <a asp-controller="Home" asp-action="Add">Add your first movie</a>.</p>
}
